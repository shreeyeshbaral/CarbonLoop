# ===================================================
# CARBONLOOP — Environment Configuration Template
# ===================================================

# ---------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.9716
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.5946
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=14

# ---------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ---------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://carbonloop_user:carbonloop_pass@localhost:5432/carbonloop_db?schema=public
AI_SERVICE_URL=http://localhost:8000
OPTIMIZATION_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------
# AI SERVICE CONFIGURATION (ai-service/.env)
# ---------------------------------------------------
AI_SERVICE_PORT=8000
LLM_PROVIDER=openai # openai | anthropic | gemini | mock
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------
# OPTIMIZATION SERVICE CONFIGURATION (optimization-service/.env)
# ---------------------------------------------------
OPTIMIZATION_SERVICE_PORT=8001
OSRM_BASE_URL=http://router.project-osrm.org
